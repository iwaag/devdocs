+BundleDetailOption = Annotated[bool, typer.Option("--detail", help="Include raw nodeutils facts in actual_detail.json.")]
+BundleJsonOption = Annotated[bool, typer.Option("--json", help="Print the nctl.bundle.v1 envelope as JSON.")]
+
+
+@app.command()
+def bundle(
+    config: ConfigOption = None,
+    detail: BundleDetailOption = False,
+    ttl: UploadTtlOption = None,
+    json_output: BundleJsonOption = False,
+) -> None:
+    """Collect the complete cluster state and print one time-limited download URL."""
+    cfg = _load_config(config)
+    try:
+        store = make_store(cfg)
+    except ConfigError as exc:
+        typer.echo(f"error: {exc}", err=True)
+        raise typer.Exit(EXIT_USAGE)
+    envelope = build_bundle(cfg, detail=detail, ttl=ttl, store=store)
+    emit(envelope, json_output, render_bundle_text)
+    if any(error.code == "invalid_ttl" for error in envelope.errors):
+        raise typer.Exit(EXIT_USAGE)
+    raise typer.Exit(EXIT_OK if envelope.ok else EXIT_FAILURE)
+
+
